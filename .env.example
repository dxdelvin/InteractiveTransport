# ---- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
RELOAD=true
LOG_LEVEL=info

# Which city opens first: "augsburg" or "mbta" (Boston, live positions)
DEFAULT_PROVIDER=augsburg

# ---- Augsburg -------------------------------------------------------------
# Optional: the official GTFS feed (AVV open data, or DELFI's gtfs.de feed).
# When the file exists, lines, stops and shapes come from it instead of the
# bundled approximation.
AUGSBURG_GTFS_PATH=app/data/gtfs/augsburg.zip
# Live departures from the Bavarian EFA planner (bahnland-bayern.de)
EFA_ENABLED=true

# ---- Boston (MBTA V3 API, live vehicle positions) ---------------------------
# Works without a key (~20 requests/min). Free key: https://api-v3.mbta.com/register
MBTA_API_KEY=
MBTA_POLL_SECONDS=10
# 0 = light rail, 1 = subway, 2 = commuter rail, 3 = bus
MBTA_ROUTE_TYPES=0,1

# ---- AI trip assistant (OpenAI) ---------------------------------------------
# Without a key the assistant still answers common questions with a built-in parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: any OpenAI-compatible endpoint
OPENAI_BASE_URL=

# ---- Realtime -------------------------------------------------------------
BROADCAST_INTERVAL_SECONDS=1.0
